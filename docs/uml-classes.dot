digraph SportFlowUML {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.75, splines=polyline, fontname="Arial", label="Diagrama de classes de domínio do SportFlow", labelloc=t, fontsize=22, fontcolor="#1f2937"];
  node [shape=record, style="rounded,filled", fillcolor="#f8fafc", color="#315a94", penwidth=1.4, fontname="Arial", fontsize=10];
  edge [color="#475569", penwidth=1.3, arrowsize=0.7, fontname="Arial", fontsize=9];

  Usuario [label="{Usuario|id: UUID\lnome: String\lemail: String\lperfil: PerfilUsuario\lativo: boolean\l}"];
  Estabelecimento [label="{Estabelecimento|id: UUID\lnome: String\lemail: String\lativo: boolean\l}"];
  Funcionario [label="{Funcionario|id: UUID\lcargo: String\ldataAdmissao: LocalDate\lativo: boolean\l}"];
  Quadra [label="{Quadra|id: UUID\lnome: String\ltipoPiso: String\lcoberta: boolean\lvalorHora: BigDecimal\l}"];
  Esporte [label="{Esporte|id: UUID\lnome: String\lativo: boolean\l}"];
  Horario [label="{Horario|id: UUID\ldiaSemana: Short\lhoraInicio: LocalTime\lhoraFim: LocalTime\lativo: boolean\l}"];
  Agendamento [label="{Agendamento|id: UUID\ldataAgendamento: LocalDate\lvalorTotal: BigDecimal\lstatus: String\l}"];
  Pagamento [label="{Pagamento|id: UUID\lvalor: BigDecimal\lforma: String\lstatus: PagamentoStatus\l}"];
  Avaliacao [label="{Avaliacao|id: UUID\lnota: Short\lcomentario: String\l}"];

  Usuario -> Estabelecimento [label="gestor 1       0..*"];
  Usuario -> Funcionario [label="1       0..1"];
  Estabelecimento -> Funcionario [label="1       0..*"];
  Estabelecimento -> Quadra [label="1       0..*"];
  Quadra -> Horario [label="1       0..*"];
  Esporte -> Horario [label="1       0..*"];
  Usuario -> Agendamento [label="1       0..*"];
  Horario -> Agendamento [label="1       0..*"];
  Agendamento -> Pagamento [label="1       0..1"];
  Agendamento -> Avaliacao [label="1       0..1"];
}
